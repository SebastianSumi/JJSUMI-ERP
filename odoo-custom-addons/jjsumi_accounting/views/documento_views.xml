<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="jjsumi_documento_view_list" model="ir.ui.view">
        <field name="name">jjsumi.documento.list</field>
        <field name="model">jjsumi.documento</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="carpeta"/>
                <field name="partner_id"/>
                <field name="fecha"/>
                <field name="vencimiento"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="jjsumi_documento_view_form" model="ir.ui.view">
        <field name="name">jjsumi.documento.form</field>
        <field name="model">jjsumi.documento</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="carpeta"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="fecha"/>
                            <field name="vencimiento"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="archivo" filename="archivo_nombre"/>
                        <field name="archivo_nombre" invisible="1"/>
                        <field name="notas"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="jjsumi_documento_view_search" model="ir.ui.view">
        <field name="name">jjsumi.documento.search</field>
        <field name="model">jjsumi.documento</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="vencidos" string="Vencidos"
                        domain="[('vencimiento', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="g_carpeta" string="Carpeta" context="{'group_by': 'carpeta'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="jjsumi_documento_action" model="ir.actions.act_window">
        <field name="name">Documentos</field>
        <field name="res_model">jjsumi.documento</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
