<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="jjsumi_hoja_view_list" model="ir.ui.view">
        <field name="name">jjsumi.hoja.list</field>
        <field name="model">jjsumi.hoja</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tipo"/>
                <field name="fecha"/>
                <field name="total_ingresos"/>
                <field name="total_egresos"/>
                <field name="resultado"/>
                <field name="margen"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="jjsumi_hoja_view_form" model="ir.ui.view">
        <field name="name">jjsumi.hoja.form</field>
        <field name="model">jjsumi.hoja</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tipo"/>
                            <field name="fecha"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_ingresos"/>
                            <field name="total_egresos"/>
                            <field name="resultado"/>
                            <field name="margen"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="concepto"/>
                            <field name="sentido"/>
                            <field name="cantidad"/>
                            <field name="precio"/>
                            <field name="monto" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="jjsumi_hoja_action" model="ir.actions.act_window">
        <field name="name">Hojas de cálculo</field>
        <field name="res_model">jjsumi.hoja</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_jjsumi_documentos" name="Documentos" parent="jjsumi_base.menu_jjsumi_finanzas"
              action="jjsumi_documento_action" sequence="10"/>
    <menuitem id="menu_jjsumi_hojas" name="Hojas de cálculo" parent="jjsumi_base.menu_jjsumi_finanzas"
              action="jjsumi_hoja_action" sequence="30"/>
</odoo>
