<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jjsumi_approval_list" model="ir.ui.view">
        <field name="name">jjsumi.approval.request.list</field>
        <field name="model">jjsumi.approval.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="request_type"/>
                <field name="requester_id"/>
                <field name="approver_id"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_jjsumi_approval_form" model="ir.ui.view">
        <field name="name">jjsumi.approval.request.form</field>
        <field name="model">jjsumi.approval.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud">
                <header>
                    <button name="action_send" type="object" string="Enviar" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Iniciar revisión" invisible="state != 'sent'"/>
                    <button name="action_approve" type="object" string="Aprobar" invisible="state not in ('sent', 'review')" class="btn-primary"/>
                    <button name="action_reject" type="object" string="Rechazar" invisible="state not in ('sent', 'review')"/>
                    <button name="action_done" type="object" string="Ejecutar" invisible="state != 'approved'" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state not in ('draft', 'sent', 'review')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,review,approved,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="request_type"/>
                            <field name="requester_id"/>
                            <field name="approver_id"/>
                        </group>
                        <group>
                            <field name="target_user_id"/>
                            <field name="target_employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Detalle">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Decisión" invisible="state in ('draft', 'sent')">
                        <field name="decision_notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_jjsumi_approval" model="ir.actions.act_window">
        <field name="name">Solicitudes de aprobación</field>
        <field name="res_model">jjsumi.approval.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
