<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_jjsumi_audit_list" model="ir.ui.view">
        <field name="name">jjsumi.audit.event.list</field>
        <field name="model">jjsumi.audit.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="create_date"/>
                <field name="operation"/>
                <field name="summary"/>
                <field name="model_name"/>
                <field name="res_display"/>
                <field name="actor_id"/>
            </list>
        </field>
    </record>
    <record id="view_jjsumi_audit_form" model="ir.ui.view">
        <field name="name">jjsumi.audit.event.form</field>
        <field name="model">jjsumi.audit.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="create_date"/>
                            <field name="operation"/>
                            <field name="summary"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="res_display"/>
                            <field name="actor_id"/>
                        </group>
                    </group>
                    <group string="Detalle">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_jjsumi_audit" model="ir.actions.act_window">
        <field name="name">Eventos de auditoría</field>
        <field name="res_model">jjsumi.audit.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
