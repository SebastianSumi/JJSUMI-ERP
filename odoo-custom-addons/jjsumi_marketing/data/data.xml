<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_automatizacion" model="ir.cron">
            <field name="name">JJSumi: ejecutar automatizaciones de marketing</field>
            <field name="model_id" ref="model_jjsumi_automatizacion"/>
            <field name="state">code</field>
            <field name="code">model._cron_ejecutar()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
    <function model="jjsumi.marketing.seed" name="_jjsumi_seed"/>
</odoo>
