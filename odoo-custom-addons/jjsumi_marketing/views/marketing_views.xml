<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Automatización -->
    <record id="jjsumi_automatizacion_view_list" model="ir.ui.view">
        <field name="name">jjsumi.automatizacion.list</field>
        <field name="model">jjsumi.automatizacion</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="disparador"/>
                <field name="dias"/>
                <field name="canal"/>
                <field name="activo"/>
                <field name="log_count"/>
            </list>
        </field>
    </record>

    <record id="jjsumi_automatizacion_view_form" model="ir.ui.view">
        <field name="name">jjsumi.automatizacion.form</field>
        <field name="model">jjsumi.automatizacion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_ejecutar_ahora" string="Ejecutar ahora" type="object" class="btn-primary"/>
                    <button name="action_ver_log" string="Ver historial" type="object"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="activo"/>
                            <field name="disparador"/>
                            <field name="dias"/>
                        </group>
                        <group>
                            <field name="canal"/>
                            <field name="asunto" invisible="canal != 'correo'"/>
                            <field name="log_count"/>
                        </group>
                    </group>
                    <field name="mensaje" placeholder="Hola {nombre}, ..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="jjsumi_automatizacion_action" model="ir.actions.act_window">
        <field name="name">Automatización</field>
        <field name="res_model">jjsumi.automatizacion</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="jjsumi_automatizacion_log_view_list" model="ir.ui.view">
        <field name="name">jjsumi.automatizacion.log.list</field>
        <field name="model">jjsumi.automatizacion.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha"/>
                <field name="automatizacion_id"/>
                <field name="partner_id"/>
                <field name="canal"/>
                <field name="estado" widget="badge"/>
                <field name="detalle"/>
                <button name="action_abrir_enlace" type="object" string="Abrir WhatsApp" icon="fa-whatsapp"
                        invisible="not enlace"/>
                <field name="enlace" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="jjsumi_automatizacion_log_view_form" model="ir.ui.view">
        <field name="name">jjsumi.automatizacion.log.form</field>
        <field name="model">jjsumi.automatizacion.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="automatizacion_id"/>
                        <field name="partner_id"/>
                        <field name="fecha"/>
                        <field name="canal"/>
                        <field name="estado"/>
                        <field name="enlace"/>
                        <field name="detalle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Redes sociales -->
    <record id="jjsumi_red_view_list" model="ir.ui.view">
        <field name="name">jjsumi.red.publicacion.list</field>
        <field name="model">jjsumi.red.publicacion</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="red"/>
                <field name="fecha_programada"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="jjsumi_red_view_form" model="ir.ui.view">
        <field name="name">jjsumi.red.publicacion.form</field>
        <field name="model">jjsumi.red.publicacion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_abrir_facebook" string="Compartir en Facebook" type="object"
                            invisible="red == 'whatsapp'"/>
                    <button name="action_abrir_whatsapp" string="Compartir por WhatsApp" type="object"
                            invisible="red == 'facebook'"/>
                    <button name="action_programar" string="Programar" type="object" class="btn-primary"
                            invisible="state != 'borrador'"/>
                    <button name="action_publicado" string="Marcar publicado" type="object"
                            invisible="state == 'publicado'"/>
                    <button name="action_borrador" string="Volver a borrador" type="object"
                            invisible="state == 'borrador'"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,programado,publicado"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="red"/>
                            <field name="fecha_programada"/>
                            <field name="enlace_destino"/>
                        </group>
                        <group>
                            <field name="imagen" widget="image" options="{'size': [128, 128]}"/>
                        </group>
                    </group>
                    <field name="mensaje" placeholder="Texto de la publicación..."/>
                    <group invisible="1">
                        <field name="enlace_facebook"/>
                        <field name="enlace_whatsapp"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="jjsumi_red_action" model="ir.actions.act_window">
        <field name="name">Redes sociales</field>
        <field name="res_model">jjsumi.red.publicacion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_jjsumi_automatizacion" name="Automatización" parent="jjsumi_base.menu_jjsumi_marketing"
              action="jjsumi_automatizacion_action" sequence="10"/>
    <menuitem id="menu_jjsumi_redes" name="Redes sociales" parent="jjsumi_base.menu_jjsumi_marketing"
              action="jjsumi_red_action" sequence="20"/>
</odoo>
