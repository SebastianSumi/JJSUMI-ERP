<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_department_form_jjsumi" model="ir.ui.view">
        <field name="name">hr.department.form.jjsumi</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="jjsumi_code"/>
                <field name="jjsumi_sede"/>
            </field>
        </field>
    </record>
    <record id="view_job_form_jjsumi" model="ir.ui.view">
        <field name="name">hr.job.form.jjsumi</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="jjsumi_code"/>
            </field>
        </field>
    </record>
    <record id="view_employee_form_jjsumi" model="ir.ui.view">
        <field name="name">hr.employee.form.jjsumi</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="job_title" position="before">
                <field name="jjsumi_code"/>
                <field name="jjsumi_area_id"/>
            </field>
        </field>
    </record>
</odoo>
