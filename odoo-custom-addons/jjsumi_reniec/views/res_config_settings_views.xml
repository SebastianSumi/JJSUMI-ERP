<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_jjsumi_reniec" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.jjsumi.reniec</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Consulta RENIEC / SUNAT (JJSUMI)" name="jjsumi_reniec_settings">
                    <setting id="jjsumi_reniec_provider_setting"
                             string="Proveedor de consulta DNI / RUC"
                             help="Elija una API con plan gratuito (apis.net.pe, apisperu.com, apiperu.dev) e ingrese su token para jalar datos reales.">
                        <field name="jjsumi_reniec_provider"/>
                        <div class="mt-2" invisible="jjsumi_reniec_provider == 'mock'">
                            <label for="jjsumi_reniec_token" string="Token API"/>
                            <field name="jjsumi_reniec_token" password="True" placeholder="Pegue aquí su token gratuito..."/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
