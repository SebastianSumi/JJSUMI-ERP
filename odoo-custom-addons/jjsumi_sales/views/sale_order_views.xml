<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_jjsumi" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.jjsumi</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="JJSumi" name="jjsumi">
                    <group>
                        <group string="Reparto">
                            <field name="delivery_zone"/>
                            <field name="bolsas_total"/>
                            <field name="bolsas_bonificadas"/>
                            <field name="viajes_estimados"/>
                            <field name="transport_cost"/>
                        </group>
                        <group string="Rentabilidad">
                            <field name="total_cost"/>
                            <field name="profit"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
