<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reglas multiempresa nativas ya existen; aquí añadimos regla de sede para áreas JJSUMI -->
        <record id="jjsumi_area_comp_rule" model="ir.rule">
            <field name="name">JJSUMI Area multi company</field>
            <field name="model_id" ref="jjsumi_org.model_jjsumi_area"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
    </data>
</odoo>
